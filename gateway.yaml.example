route:
  - name: mech-writer
    backend:
      - base_url: "http://localhost:11434/v1"
        model: "qwen2.5:7b-instruct"
        # Keep-alive: opcional. 4 min < keep_alive de Ollama (5 min) mantiene el
        # modelo residente y evita el arranque en frío.
        warmup:
          interval_ms: 240000
          # Opcional. Timeout de cada warmup (default 30 s). Súbelo (p. ej.
          # 300000) si el cold load del modelo supera los 30 s (p. ej. un 14B
          # tarda ~90 s en cargar).
          # timeout_ms: 300000
      - base_url: "https://openrouter.ai/api/v1"
        model: "qwen/qwen3-8b"
        api_key_env: "OPENROUTER_API_KEY"
        # Opcional. No-stream: timeout total (default 120s si se omite).
        # Streaming: timeout de primer byte (default 5s).
        timeout_ms: 30000
  # Upstream OpenAI-compatible de terceros (p. ej. LocalAI servido en :9090).
  # Cualquier `base_url` que hable la API de OpenAI sirve como backend.
  - name: localai
    backend:
      - base_url: "http://127.0.0.1:9090/v1"
        model: "qwen3-1.7b"
        timeout_ms: 120000
        warmup:
          interval_ms: 240000
          timeout_ms: 300000
      - base_url: "https://openrouter.ai/api/v1"
        model: "qwen/qwen3-8b"
        api_key_env: "OPENROUTER_API_KEY"
        timeout_ms: 30000
  # Rutas dinámicas de modelos GRATUITOS de OpenRouter por perfil. El backend
  # `kind: openrouter_free` descubre el catálogo free (GET /models), clasifica
  # los modelos con tool-calling para el `profile` y los usa como cadena de
  # candidatos con failover, rotación y blacklist. El `model` se ignora en los
  # backends dinámicos. Detrás va un backend de PAGO como respaldo (sustituye
  # los placeholders por modelos reales). Ver docs/openrouter-free-routing.md.
  - name: architect
    backend:
      - kind: openrouter_free
        profile: architect
        base_url: "https://openrouter.ai/api/v1"
        api_key_env: "OPENROUTER_API_KEY"
        discovery:
          refresh_interval_ms: 300000
          blacklist_cooldown_ms: 60000
          min_context: 32768
      - base_url: "https://openrouter.ai/api/v1"   # fallback de PAGO (razonamiento)
        model: "<REEMPLAZA-modelo-pago-razonamiento>"
        api_key_env: "OPENROUTER_API_KEY"
  - name: code
    backend:
      - kind: openrouter_free
        profile: code
        base_url: "https://openrouter.ai/api/v1"
        api_key_env: "OPENROUTER_API_KEY"
        discovery:
          refresh_interval_ms: 300000
          blacklist_cooldown_ms: 60000
          min_context: 32768
      - base_url: "https://openrouter.ai/api/v1"   # fallback de PAGO (coder)
        model: "<REEMPLAZA-modelo-pago-coder>"
        api_key_env: "OPENROUTER_API_KEY"
  - name: writer
    backend:
      - kind: openrouter_free
        profile: writer
        base_url: "https://openrouter.ai/api/v1"
        api_key_env: "OPENROUTER_API_KEY"
        discovery:
          refresh_interval_ms: 300000
          blacklist_cooldown_ms: 60000
          min_context: 32768
      - base_url: "https://openrouter.ai/api/v1"   # fallback de PAGO (prosa)
        model: "<REEMPLAZA-modelo-pago-prosa>"
        api_key_env: "OPENROUTER_API_KEY"

# Observabilidad (opcional). Ausente → el gateway no exporta nada por OTLP y
# solo expone /metrics en formato Prometheus, como antes.
# observability:
#   otlp:
#     # Base del colector, sin `/api/<organización>`.
#     endpoint: "http://localhost:5080"
#     organization: "default"
#     # Solo `http` está soportado hoy; `grpc` se rechaza al validar.
#     protocol: http
#     # Nombre de la variable de entorno con el token de ingesta. NUNCA se
#     # escribe el token aquí: el gateway lo lee del entorno y lo envía como
#     # `Authorization: Basic <token>`. Si la variable no existe, el arranque falla.
#     token_env: "OPENOBSERVE_TOKEN"
#     # Nombre de servicio reportado como recurso OTel (opcional).
#     service_name: "llm-gateway"
#     # Intervalo de exportación en ms (default 15000) y timeout por export (opcional).
#     interval_ms: 15000
#     # timeout_ms: 10000
#     # Al menos una señal debe estar activa; si el bloque existe con todas a
#     # false, la carga de la configuración falla.
#     signals:
#       metrics: true
#       logs: true
#       traces: true
